PORT=3000
NODE_ENV=development

# Neon PostgreSQL. Obtener string desde: https://console.neon.tech -> Dashboard -> Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com
GFW_API_TOKEN=
FIRMS_MAP_KEY=
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
REQUEST_TIMEOUT_MS=15000
FRONTEND_ORIGIN=http://localhost:4321,http://localhost:5173
FOREST_LOSS_MAX_PERCENT=1
FOREST_LOSS_EDGE_BAND=0.25
ANP_EDGE_BAND=0.25
REPORT_DEMO_MODE=false
PUBLIC_VERIFICATION_URL=http://localhost:4321/verificar
# GeoJSON oficial o snapshot administrado de Areas Naturales Protegidas
ANP_GEOJSON_URL=
