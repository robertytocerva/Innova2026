---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/landing/NavBar.astro";
import SiteFooter from "../components/landing/SiteFooter.astro";
import Icon from "../components/ui/Icon.astro";
import { navData, footerData } from "../data/landing";
---

<Layout title="Reportes ambientales — TerraVision">
  <NavBar
    brandName={navData.brandName}
    links={navData.links}
    ctaLabel={navData.ctaLabel}
    ctaHref={navData.ctaHref}
    ctaDataPath={navData.ctaDataPath}
  />

  <main class="min-h-screen bg-surface-container-lowest">
    <section class="mx-auto max-w-7xl px-gutter-desktop py-12">
      <p class="flex items-center gap-2 font-label-md text-label-md uppercase tracking-widest text-secondary">
        <Icon name="folder_open" size={18} /> Archivo de reportes
      </p>
      <div class="mt-2 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="font-headline-xl text-headline-xl font-bold text-on-surface">Expedientes generados</h1>
          <p class="mt-2 max-w-3xl font-body-md text-body-md text-on-surface-variant">
            Consulta, filtra y descarga los reportes creados desde la auditoría multitemporal de los polígonos del mapa interactivo.
          </p>
        </div>
        <a href="/visor" class="inline-flex items-center justify-center gap-2 rounded-xl bg-secondary px-4 py-3 font-semibold text-surface transition-colors hover:bg-primary">
          <Icon name="map" size={18} /> Volver al mapa
        </a>
      </div>

      <div id="reportStatus" class="mt-6 hidden rounded-xl border p-4 text-sm" role="status"></div>

      <section class="mt-8 rounded-2xl border border-surface-container-high bg-surface p-5 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end">
          <label class="min-w-0 flex-1">
            <span class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-on-surface-variant">Buscar</span>
            <div class="relative">
              <Icon name="search" size={18} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" />
              <input id="reportSearch" type="search" placeholder="Folio, código, huerta o municipio" class="w-full rounded-xl border border-outline-variant bg-surface-container-low py-3 pl-10 pr-3 text-sm text-on-surface outline-none focus:ring-2 focus:ring-secondary" />
            </div>
          </label>
          <label class="w-full lg:w-52">
            <span class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-on-surface-variant">Veredicto</span>
            <select id="verdictFilter" class="w-full rounded-xl border border-outline-variant bg-surface-container-low px-3 py-3 text-sm text-on-surface outline-none focus:ring-2 focus:ring-secondary">
              <option value="">Todos</option>
              <option value="cumple">Cumple</option>
              <option value="no cumple">No cumple</option>
              <option value="requiere revision">Requiere revisión</option>
            </select>
          </label>
          <label class="w-full lg:w-52">
            <span class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-on-surface-variant">Estado</span>
            <select id="statusFilter" class="w-full rounded-xl border border-outline-variant bg-surface-container-low px-3 py-3 text-sm text-on-surface outline-none focus:ring-2 focus:ring-secondary">
              <option value="">Todos</option>
              <option value="generated">PDF generado</option>
              <option value="approved">Aprobado</option>
              <option value="draft">Borrador</option>
            </select>
          </label>
          <button id="clearFilters" type="button" class="rounded-xl border border-outline-variant px-4 py-3 text-sm font-semibold text-on-surface-variant transition-colors hover:bg-surface-container-low">Limpiar</button>
        </div>
      </section>

      <div class="mt-6 flex items-center justify-between gap-3">
        <h2 class="font-headline-md text-headline-md font-semibold text-on-surface">Resultados</h2>
        <span id="reportCount" class="text-sm text-on-surface-variant">Cargando...</span>
      </div>
      <div id="reportsList" class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
    </section>
  </main>

  <SiteFooter brand={footerData.brand} columns={footerData.columns} legal={footerData.legal} />
</Layout>

<script>
  import { listExpedientes, pdfUrl } from "../lib/reportApi";
  import type { Expediente } from "../types/reports";

  let reports: Expediente[] = [];
  const list = document.querySelector<HTMLElement>("#reportsList");
  const count = document.querySelector<HTMLElement>("#reportCount");
  const status = document.querySelector<HTMLElement>("#reportStatus");
  const search = document.querySelector<HTMLInputElement>("#reportSearch");
  const verdict = document.querySelector<HTMLSelectElement>("#verdictFilter");
  const state = document.querySelector<HTMLSelectElement>("#statusFilter");

  const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[char] || char);
  const formatDate = (value?: string) => value ? new Date(value).toLocaleDateString("es-MX") : "Sin fecha";
  const verdictLabel = (value: string) => value === "cumple" ? "Cumple" : value === "no cumple" ? "No cumple" : "Requiere revisión";
  const verdictClass = (value: string) => value === "cumple" ? "bg-emerald-100 text-emerald-800" : value === "no cumple" ? "bg-red-100 text-red-800" : "bg-amber-100 text-amber-800";

  function renderReports() {
    const term = search?.value.trim().toLowerCase() || "";
    const filtered = reports.filter((report) => {
      const searchable = [report.folio, report.reference_code, report.name, report.municipality].join(" ").toLowerCase();
      return (!term || searchable.includes(term)) && (!verdict?.value || report.verdict === verdict.value) && (!state?.value || report.status === state.value);
    });
    if (count) count.textContent = `${filtered.length} de ${reports.length} expediente${reports.length === 1 ? "" : "s"}`;
    if (!list) return;
    list.innerHTML = filtered.length ? filtered.map((report) => `
      <article class="flex flex-col rounded-2xl border border-surface-container-high bg-surface p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
        <div class="flex items-start justify-between gap-3">
          <div>
            <span class="font-mono text-xs text-on-surface-variant">${escapeHtml(report.folio)}</span>
            <h3 class="mt-1 font-headline-sm text-headline-sm font-semibold text-on-surface">${escapeHtml(report.name || report.reference_code || report.parcel_id)}</h3>
          </div>
          <span class="rounded-full px-2.5 py-1 text-[11px] font-bold ${verdictClass(report.verdict)}">${verdictLabel(report.verdict)}</span>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
          <div><span class="block text-on-surface-variant">Municipio</span><strong class="text-on-surface">${escapeHtml(report.municipality || "Michoacán")}</strong></div>
          <div><span class="block text-on-surface-variant">Estado</span><strong class="text-on-surface">${escapeHtml(report.status)}</strong></div>
          <div><span class="block text-on-surface-variant">Auditoría</span><strong class="text-on-surface">${report.audit_from_year && report.audit_to_year ? `${report.audit_from_year}–${report.audit_to_year}` : "Ambiental"}</strong></div>
          <div><span class="block text-on-surface-variant">Emisión</span><strong class="text-on-surface">${formatDate(report.issued_at || report.created_at)}</strong></div>
        </div>
        <div class="mt-5 flex flex-wrap gap-2 border-t border-surface-container-high pt-4">
          ${report.status === "generated" ? `<a href="${escapeHtml(pdfUrl(report.folio))}" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-secondary px-3 py-2 text-xs font-bold text-surface hover:bg-primary"><span class="material-symbols-outlined text-[16px]">download</span>Descargar PDF</a>` : '<span class="text-xs text-on-surface-variant">PDF pendiente de generación</span>'}
          ${report.status === "generated" ? `<a href="/verificar?folio=${encodeURIComponent(report.folio)}" class="inline-flex items-center gap-1.5 rounded-lg border border-outline-variant px-3 py-2 text-xs font-semibold text-on-surface-variant hover:bg-surface-container-low"><span class="material-symbols-outlined text-[16px]">qr_code_scanner</span>Verificar</a>` : ""}
        </div>
      </article>`).join("") : '<div class="rounded-2xl border border-dashed border-outline-variant p-10 text-center text-sm text-on-surface-variant md:col-span-2 xl:col-span-3">No hay reportes que coincidan con los filtros.</div>';
  }

  async function loadReports() {
    try {
      reports = await listExpedientes();
      renderReports();
    } catch (error) {
      if (status) {
        status.textContent = error instanceof Error ? error.message : "No fue posible cargar los reportes.";
        status.className = "mt-6 rounded-xl border border-error bg-error-container p-4 text-sm text-on-error-container";
      }
    }
  }

  [search, verdict, state].forEach((control) => {
    control?.addEventListener("input", renderReports);
    control?.addEventListener("change", renderReports);
  });
  document.querySelector<HTMLButtonElement>("#clearFilters")?.addEventListener("click", () => {
    if (search) search.value = "";
    if (verdict) verdict.value = "";
    if (state) state.value = "";
    renderReports();
  });
  loadReports();
</script>
