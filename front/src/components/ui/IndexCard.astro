---
import Icon from "./Icon.astro";
import type { IndexCard } from "../../types/landing";

interface Props {
  index: IndexCard;
}

const { index } = Astro.props;
---

<div class="group bg-surface-container-lowest rounded-xl p-space-xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between hover:-translate-y-1.5 border border-surface-container-high/0 hover:border-tertiary-fixed/50 relative overflow-hidden">
  <div class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-gradient-to-bl from-tertiary-fixed/20 to-transparent blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
  <div class="flex flex-col gap-space-md relative">
    <div class="flex items-start justify-between w-full">
      <div class={`w-12 h-12 rounded-xl ${index.iconBg} flex items-center justify-center ${index.iconFg} shadow-sm transition-transform duration-300 group-hover:scale-110 overflow-hidden`}>
        <Icon name={index.icon} size={26} />
      </div>
      <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container-low px-2 py-0.5 rounded">{index.bandCombo}</span>
    </div>
    <div>
      <span class={`font-label-sm text-label-sm font-bold tracking-wider ${index.categoryTone}`}>
        {index.category}
      </span>
      <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface mt-1 leading-snug">{index.title}</h3>
    </div>
    <p class="font-body-sm text-body-sm text-on-surface-variant">{index.description}</p>
    <div class="p-space-sm rounded-lg bg-gradient-to-r from-secondary-fixed/15 to-tertiary-fixed/15 font-label-sm text-label-sm text-on-surface flex items-center justify-between border border-secondary-fixed/20">
      <span>Fórmula estándar:</span>
      <code class="font-bold text-primary font-mono">{index.formula}</code>
    </div>
  </div>
  <div class="mt-space-lg pt-space-md flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm border-t border-surface-container-high">
    <span>{index.range}</span>
    <span class="text-primary font-semibold flex items-center gap-1">
      <Icon name="check_circle" size={16} />
      {index.resolution}
    </span>
  </div>
</div>
