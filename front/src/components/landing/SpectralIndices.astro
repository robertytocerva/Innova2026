---
import IndexCard from "../ui/IndexCard.astro";
import type { IndexCard as IndexCardData, Pipeline } from "../../types/landing";

interface Props {
  kicker: string;
  title: string;
  description: string;
  indices: IndexCardData[];
  pipeline: Pipeline;
}

const { kicker, title, description, indices, pipeline } = Astro.props;
---

<section class="w-full py-space-3xl px-gutter-desktop bg-surface-container-lowest">
  <div class="max-w-7xl mx-auto flex flex-col gap-space-2xl">
    <div class="text-center max-w-3xl mx-auto flex flex-col gap-space-xs">
      <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase font-semibold">{kicker}</span>
      <h2 class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight">{title}</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">{description}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
      {indices.map((index) => <IndexCard index={index} />)}
    </div>

    <div class="w-full bg-surface-container-low rounded-2xl p-space-xl flex flex-col lg:flex-row items-center justify-between gap-space-lg">
      <div class="flex flex-col gap-1 max-w-md">
        <div class="font-label-sm text-label-sm font-bold text-primary uppercase tracking-wider">{pipeline.kicker}</div>
        <div class="font-headline-sm text-headline-sm font-bold text-on-surface">{pipeline.title}</div>
        <p class="font-body-sm text-body-sm text-on-surface-variant">{pipeline.description}</p>
      </div>
      <div class="flex-1 grid grid-cols-2 sm:grid-cols-4 gap-space-sm w-full">
        {pipeline.phases.map((phase) => (
          <div class="bg-surface-container-lowest p-space-md rounded-xl flex flex-col gap-1 shadow-sm text-center">
            <span class="font-label-sm text-label-sm text-primary font-bold">{phase.phase}</span>
            <span class="font-headline-sm text-headline-sm text-sm font-bold text-on-surface">{phase.title}</span>
            <span class="text-label-sm font-label-sm text-on-surface-variant">{phase.description}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
