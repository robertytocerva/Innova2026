---
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import type { NavProps } from "../../types/landing";

interface Props extends NavProps {}

const { brandName, links, ctaLabel, ctaHref, ctaDataPath } = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath === href;
};
---

<header class="sticky top-0 z-50 w-full bg-on-surface/90 backdrop-blur-md border-b border-surface/10 shadow-lg">
  <nav class="max-w-7xl mx-auto px-gutter-desktop h-20 flex items-center justify-between gap-space-md">
    <a href="#inicio" data-path="inicio" class="flex items-center gap-space-xs shrink-0 group">
      <img src="/logoBlanco.png" alt={brandName} class="h-11 w-auto object-contain" />
      <span class="font-headline-sm text-headline-sm text-surface font-bold tracking-tight group-hover:text-tertiary transition-colors">
        {brandName}
      </span>
    </a>

    <ul class="hidden lg:flex items-center gap-1 bg-surface/10 p-1 rounded-full">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-path={link.dataPath}
            class={`inline-flex items-center px-4 py-2 rounded-full font-label-md text-label-md transition-all duration-200 ${
              isActive(link.href)
                ? "bg-tertiary text-on-tertiary font-semibold shadow-md"
                : "text-inverse-on-surface/85 hover:bg-surface/10 hover:text-surface"
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-space-sm shrink-0">
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl bg-surface/10 text-surface hover:bg-tertiary hover:text-on-tertiary transition-colors"
        aria-label="Abrir menú"
        data-nav-toggle
      >
        <Icon name="menu" size={22} />
      </button>
      <div class="hidden lg:block">
        <Button label={ctaLabel} href={ctaHref} icon="login" variant="inverted" dataPath={ctaDataPath} />
      </div>
    </div>
  </nav>

  <div
    class="lg:hidden hidden bg-on-surface border-t border-surface/10"
    data-nav-menu
  >
    <ul class="flex flex-col px-gutter-desktop py-space-sm gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-path={link.dataPath}
            class={`block px-4 py-2.5 rounded-xl font-label-md text-label-md transition-colors ${
              isActive(link.href)
                ? "bg-tertiary text-on-tertiary font-semibold"
                : "text-inverse-on-surface/85 hover:bg-surface/10 hover:text-surface"
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-space-xs">
        <Button label={ctaLabel} href={ctaHref} icon="login" variant="inverted" dataPath={ctaDataPath} fullWidth />
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLDivElement>("[data-nav-menu]");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
