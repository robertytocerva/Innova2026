---
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import type { CtaLink, ComplianceItem, SensorPin, TelemetryMeta } from "../../types/landing";

interface Props {
  badge: { icon: string; label: string };
  headline: string;
  headlineHighlight: string;
  paragraph: string;
  primaryCta: CtaLink;
  secondaryCta: CtaLink;
  complianceItems: ComplianceItem[];
  imageUrl?: string;
  imageAlt?: string;
  imageBadge?: string;
  imageGsd?: string;
  pin?: SensorPin;
  metaTitle?: string;
  metaTitleLabel?: string;
  metaReliabilityLabel?: string;
  metaReliabilityValue?: string;
  telemetry?: TelemetryMeta;
}

const {
  badge,
  headline,
  headlineHighlight,
  paragraph,
  primaryCta,
  secondaryCta,
  complianceItems,
  telemetry,
} = Astro.props;
---

<section class="relative w-full overflow-hidden bg-on-surface text-surface py-20 md:py-28 lg:py-32 px-4 sm:px-6 lg:px-8 border-b border-surface/10 flex flex-col items-center justify-center">
  <!-- Fondo animado con Canvas GSAP nítido + Blur sutil -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <canvas id="heroAnimationCanvas" class="w-full h-full block object-cover scale-[1.02] filter blur-[2px] opacity-60"></canvas>
    <div class="absolute inset-0 bg-gradient-to-b from-on-surface/80 via-on-surface/60 to-on-surface/85"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-on-surface/20 to-on-surface/75"></div>
  </div>

  <!-- Barra de progreso sutil de la animación en el borde superior -->
  <div class="absolute top-0 inset-x-0 h-1 bg-surface/10 overflow-hidden">
    <div id="heroProgressBar" class="h-full w-0 bg-gradient-to-r from-primary via-primary-container to-secondary transition-[width] duration-75"></div>
  </div>

  <!-- Contenido 100% centrado con ancho óptimo de lectura -->
  <div class="relative z-10 max-w-5xl mx-auto flex flex-col items-center text-center">
    <!-- Badge superior -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface/10 backdrop-blur-md text-surface border border-surface/20 w-fit shadow-lg font-label-sm text-label-sm tracking-widest uppercase font-semibold mb-6">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-tertiary-fixed opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-tertiary-fixed"></span>
      </span>
      <Icon name={badge.icon} size={16} class="text-tertiary" />
      <span class="tracking-wider uppercase font-semibold">{badge.label}</span>
    </div>

    <!-- Headline centrado -->
    <h1 class="font-headline-xl text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-surface tracking-tight font-extrabold leading-[1.12]">
      {headline} <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary-container to-secondary">{headlineHighlight}</span>
    </h1>

    <!-- Párrafo centrado -->
    <p class="font-body-lg text-body-lg text-inverse-on-surface/85 max-w-3xl leading-relaxed mt-6">
      {paragraph}
    </p>

    <!-- Botones de llamada a la acción centrados -->
    <div class="flex flex-wrap items-center justify-center gap-space-sm pt-8">
      <Button
        label={primaryCta.label}
        href={primaryCta.href}
        icon={primaryCta.icon ?? (primaryCta.label === "Explorar Mapa de Zonas" ? "explore" : undefined)}
        variant="bright"
        dataPath={primaryCta.dataPath}
      />
      <Button
        label={secondaryCta.label}
        href={secondaryCta.href}
        icon="lab_profile"
        variant="outline-on-dark"
        dataPath={secondaryCta.dataPath}
      />
    </div>

    <!-- Items de certificación y cumplimiento centrados -->
    <div class="flex flex-wrap items-center justify-center gap-space-lg pt-6 text-inverse-on-surface/75 text-sm">
      {complianceItems.map((item) => (
        <div class="flex items-center gap-space-2xs">
          <Icon name={item.icon} size={18} class="text-secondary-fixed" />
          <span class="font-body-sm text-body-sm">{item.text}</span>
        </div>
      ))}
    </div>

    <!-- Barra inferior de telemetría y estado de la animación GSAP -->
    {telemetry && (
      <div class="mt-8 inline-flex flex-wrap items-center justify-center gap-3 md:gap-6 px-5 py-2 rounded-full bg-surface/10 backdrop-blur-xl border border-surface/15 text-xs text-inverse-on-surface/90 shadow-xl">
        <span class="flex items-center gap-1.5 font-mono text-[11px]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-error opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-error"></span>
          </span>
          <span>SECUENCIA GSAP</span>
          <span id="heroFrameCounter" class="px-1.5 py-0.5 rounded bg-primary/20 text-primary-fixed font-bold font-mono">T-01</span>
        </span>
        <span class="hidden sm:inline text-surface/20">|</span>
        <span class="flex items-center gap-1.5 font-medium">
          <Icon name={telemetry.bandIcon} size={16} class="text-primary-fixed" />
          {telemetry.band}
        </span>
        <span class="hidden sm:inline text-surface/20">|</span>
        <span class="font-mono text-[11px]">Nubosidad: {telemetry.cloud}</span>
        <span class="hidden sm:inline text-surface/20">|</span>
        <span class="text-secondary-fixed font-semibold flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-secondary-fixed animate-pulse"></span>
          {telemetry.status}
        </span>
      </div>
    )}
  </div>
</section>

<script>
  import gsap from "gsap";

  function initHeroAnimation() {
    const canvas = document.getElementById("heroAnimationCanvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const frameCount = 42;
    const images: HTMLImageElement[] = [];
    let loadedCount = 0;
    let animationTween: gsap.core.Tween | null = null;
    const playhead = { frame: 0 };
    const frameCounter = document.getElementById("heroFrameCounter");
    const progressBar = document.getElementById("heroProgressBar");

    // Precargar las 42 imágenes de la carpeta animaciones
    for (let i = 0; i < frameCount; i++) {
      const img = new Image();
      const num = String(i).padStart(3, "0");
      img.src = `/animaciones/frame_${num}.webp`;
      img.onload = () => {
        loadedCount++;
        if (loadedCount === 1) {
          render();
        }
        if (loadedCount >= Math.min(10, frameCount) && !animationTween) {
          startAnimation();
        }
      };
      images.push(img);
    }

    function resizeCanvas() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      render();
    }

    function render() {
      if (!canvas || !ctx) return;
      const index = Math.min(Math.max(0, Math.round(playhead.frame)), frameCount - 1);
      const img = images[index];
      if (!img || !img.complete || img.naturalWidth === 0) return;

      const cw = canvas.width;
      const ch = canvas.height;
      ctx.clearRect(0, 0, cw, ch);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";

      // Dibujar con ajuste object-cover
      const imgAspect = img.naturalWidth / img.naturalHeight;
      const canvasAspect = cw / ch;
      let dw: number, dh: number, dx: number, dy: number;

      if (canvasAspect > imgAspect) {
        dw = cw;
        dh = cw / imgAspect;
        dx = 0;
        dy = (ch - dh) / 2;
      } else {
        dh = ch;
        dw = ch * imgAspect;
        dx = (cw - dw) / 2;
        dy = 0;
      }

      ctx.drawImage(img, dx, dy, dw, dh);

      if (frameCounter) {
        frameCounter.textContent = `T-${String(index + 1).padStart(2, "0")}`;
      }
      if (progressBar) {
        const pct = (index / (frameCount - 1)) * 100;
        progressBar.style.width = `${pct}%`;
      }
    }

    function startAnimation() {
      if (animationTween) return;

      animationTween = gsap.to(playhead, {
        frame: frameCount - 1,
        snap: "frame",
        ease: "none",
        duration: 3.0,
        repeat: -1,
        yoyo: true,
        repeatDelay: 0.3,
        onUpdate: render,
      });
    }

    window.addEventListener("resize", resizeCanvas);
    resizeCanvas();

    // Respaldo de inicio si las imágenes se cargan desde caché
    setTimeout(() => {
      if (!animationTween) {
        startAnimation();
      }
    }, 400);

    // Limpieza al cambiar de página en Astro
    document.addEventListener(
      "astro:before-swap",
      () => {
        if (animationTween) {
          animationTween.kill();
          animationTween = null;
        }
        window.removeEventListener("resize", resizeCanvas);
      },
      { once: true },
    );
  }

  // Inicializar al cargar el documento o al navegar con ClientRouter
  initHeroAnimation();
  document.addEventListener("astro:page-load", initHeroAnimation);
</script>

