---
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import type { CtaLink, ComplianceItem, SensorPin, TelemetryMeta } from "../../types/landing";

interface Props {
  badge: { icon: string; label: string };
  headline: string;
  headlineHighlight: string;
  paragraph: string;
  primaryCta: CtaLink;
  secondaryCta: CtaLink;
  complianceItems: ComplianceItem[];
  imageUrl: string;
  imageAlt: string;
  imageBadge: string;
  imageGsd: string;
  pin: SensorPin;
  metaTitle: string;
  metaTitleLabel: string;
  metaReliabilityLabel: string;
  metaReliabilityValue: string;
  telemetry: TelemetryMeta;
}

const {
  badge,
  headline,
  headlineHighlight,
  paragraph,
  primaryCta,
  secondaryCta,
  complianceItems,
  imageUrl,
  imageAlt,
  imageBadge,
  imageGsd,
  pin,
  metaTitle,
  metaTitleLabel,
  metaReliabilityLabel,
  metaReliabilityValue,
  telemetry,
} = Astro.props;
---

<section class="relative w-full overflow-hidden py-space-3xl px-gutter-desktop bg-surface-container-lowest">
  <div class="absolute -top-32 right-[-5%] w-[600px] h-[600px] rounded-full bg-gradient-to-br from-primary-fixed/25 to-secondary-fixed/15 blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute top-1/2 left-[-10%] w-[450px] h-[450px] rounded-full bg-gradient-to-tr from-surface-container-high/40 to-transparent blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-2xl items-center">
      <div class="lg:col-span-7 flex flex-col gap-space-md">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-inverse-surface text-surface w-fit shadow-lg shadow-inverse-surface/30 font-label-sm text-label-sm tracking-widest uppercase font-semibold">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-tertiary-fixed opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-tertiary-fixed"></span>
          </span>
          <Icon name={badge.icon} size={16} />
          <span class="tracking-wider uppercase font-semibold">{badge.label}</span>
        </span>

        <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight font-extrabold leading-[1.08]">
          {headline} <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary-container to-secondary">{headlineHighlight}</span>
        </h1>

        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
          {paragraph}
        </p>

        <div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
          <Button
            label={primaryCta.label}
            href={primaryCta.href}
            icon={primaryCta.icon ?? (primaryCta.label === "Explorar Mapa de Zonas" ? "explore" : undefined)}
            variant="bright"
            dataPath={primaryCta.dataPath}
          />
          <Button
            label={secondaryCta.label}
            href={secondaryCta.href}
            icon="lab_profile"
            variant="secondary"
            dataPath={secondaryCta.dataPath}
          />
        </div>

        <div class="flex flex-wrap items-center gap-space-lg pt-space-sm text-on-surface-variant">
          {complianceItems.map((item) => (
            <div class="flex items-center gap-space-2xs">
              <Icon name={item.icon} size={18} class="text-secondary" />
              <span class="font-body-sm text-body-sm">{item.text}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="relative bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden p-space-xs">
          <div class="relative h-96 w-full rounded-lg overflow-hidden bg-surface-container">
            <img class="w-full h-full object-cover" alt={imageAlt} src={imageUrl} />
            <div class="absolute inset-0 bg-gradient-to-t from-on-surface/80 via-transparent to-black/30"></div>

            <div class="absolute top-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container-lowest/90 backdrop-blur-md shadow-sm">
              <span class="w-2 h-2 rounded-full bg-tertiary"></span>
              <span class="font-label-sm text-label-sm text-on-surface font-semibold">{imageBadge}</span>
            </div>
            <div class="absolute top-3 right-3 px-2 py-1 rounded-lg bg-surface-container-lowest/90 backdrop-blur-md font-label-sm text-label-sm text-on-surface">
              {imageGsd}
            </div>

            <div class="absolute top-1/3 left-1/2 -translate-x-1/2 px-3 py-1.5 rounded-xl bg-surface-container-lowest/95 backdrop-blur-md shadow-lg flex items-center gap-2">
              <Icon name={pin.icon} size={18} class={pin.iconTone} />
              <div class="flex flex-col text-left">
                <span class="font-label-sm text-label-sm font-bold text-on-surface leading-tight">{pin.title}</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant leading-none">{pin.detail}</span>
              </div>
            </div>

            <div class="absolute bottom-3 inset-x-3 p-3 rounded-lg bg-surface-container-lowest/90 backdrop-blur-md flex items-center justify-between text-on-surface">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">{metaTitleLabel}</span>
                <span class="font-headline-sm text-headline-sm font-bold text-secondary">{metaTitle}</span>
              </div>
              <div class="text-right">
                <span class="font-label-sm text-label-sm text-on-surface-variant">{metaReliabilityLabel}</span>
                <div class="font-label-md text-label-md font-bold text-secondary">{metaReliabilityValue}</div>
              </div>
            </div>
          </div>

          <div class="mt-space-xs px-space-sm py-space-xs bg-surface-container-low rounded-lg flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm">
            <span class="flex items-center gap-1">
              <Icon name={telemetry.bandIcon} size={16} class="text-primary" />
              {telemetry.band}
            </span>
            <span>Nubosidad: {telemetry.cloud}</span>
            <span class="text-secondary font-semibold">{telemetry.status}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
