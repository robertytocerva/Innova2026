---
import type { FooterProps } from "../../types/landing";

interface Props extends FooterProps {}

const { brand, columns, legal } = Astro.props;
---

<footer class="w-full bg-surface-container-low border-t border-outline-variant/30 py-space-2xl">
  <div class="max-w-7xl mx-auto px-gutter-desktop flex flex-col gap-space-xl">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-space-lg">
      <div class="flex flex-col gap-space-sm md:col-span-1">
        <div class="flex items-center gap-space-xs">
          <img alt={`${brand.name} Logo`} class="h-6 w-auto object-contain" src={brand.logo} />
          <span class="font-headline-sm text-headline-sm text-primary font-bold">{brand.name}</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant">{brand.tagline}</p>
      </div>

      {columns.map((col) => (
        <div class="flex flex-col gap-space-xs">
          <span class="font-label-lg text-label-lg text-on-surface uppercase tracking-wider font-semibold">{col.title}</span>
          {col.links.map((link) =>
            link.href ? (
              <a
                class={`font-body-sm text-body-sm ${link.muted ? "text-on-surface-variant" : "text-on-surface-variant hover:text-primary"} transition-colors`}
                href={link.href}
                data-path={link.dataPath}
              >
                {link.label}
              </a>
            ) : (
              <span class={`font-body-sm text-body-sm ${link.muted ? "text-on-surface-variant" : "text-on-surface-variant"}`}>{link.label}</span>
            )
          )}
        </div>
      ))}
    </div>

    <div class="pt-space-md border-t border-outline-variant/30 flex flex-col md:flex-row items-center justify-between gap-space-sm font-body-sm text-body-sm text-on-surface-variant">
      <span>{legal}</span>
      <span class="flex items-center gap-space-2xs">
        Material Symbols · Plus Jakarta Sans · JetBrains Mono
      </span>
    </div>
  </div>
</footer>
