---
import Icon from "../ui/Icon.astro";
import AlertItem from "../ui/AlertItem.astro";
import type { LulcBar, Alert } from "../../types/landing";

interface Props {
  kicker: string;
  title: string;
  description: string;
  periodLabel: string;
  periodValue: string;
  bars: LulcBar[];
  alertsTitle: string;
  alertsRadarLabel: string;
  alertsDescription: string;
  alerts: Alert[];
  alertsCtaLabel: string;
  methodology: string;
  matrixLinkLabel: string;
  matrixLinkHref: string;
  matrixLinkDataPath?: string;
}

const {
  kicker,
  title,
  description,
  periodLabel,
  periodValue,
  bars,
  alertsTitle,
  alertsRadarLabel,
  alertsDescription,
  alerts,
  alertsCtaLabel,
  methodology,
  matrixLinkLabel,
  matrixLinkHref,
  matrixLinkDataPath,
} = Astro.props;
---

<section class="w-full py-space-3xl px-gutter-desktop bg-surface-container-low">
  <div class="max-w-7xl mx-auto flex flex-col gap-space-xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
      <div class="flex flex-col gap-space-2xs max-w-2xl">
        <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase font-semibold">{kicker}</span>
        <h2 class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight">{title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">{description}</p>
      </div>
      <div class="flex items-center gap-space-xs">
        <span class="font-label-sm text-label-sm text-on-surface-variant">{periodLabel}</span>
        <span class="px-space-sm py-1 rounded-lg bg-surface-container-lowest shadow-sm font-label-md text-label-md text-primary font-bold">
          {periodValue}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
      <div class="lg:col-span-7 bg-surface-container-lowest rounded-xl p-space-xl shadow-sm flex flex-col justify-between gap-space-lg">
        <div class="flex items-center justify-between pb-space-sm">
          <div>
            <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">Variación Neta de Uso de Suelo</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Cambio porcentual de masa superficial agregada</p>
          </div>
          <Icon name="equalizer" class="text-outline-variant" />
        </div>

        <div class="flex flex-col gap-space-md">
          {bars.map((bar) => (
            <div class="flex flex-col gap-1.5">
              <div class="flex items-center justify-between font-label-sm text-label-sm">
                <span class="flex items-center gap-2 font-semibold text-on-surface">
                  <span class={`w-3 h-3 rounded ${bar.swatch}`}></span>
                  {bar.label}
                </span>
                <span class={`font-label-md text-label-md font-bold ${bar.deltaTone}`}>{bar.delta}</span>
              </div>
              <div class="w-full h-3 rounded-full bg-surface-container overflow-hidden flex">
                <div class={`h-full ${bar.swatch} rounded-full transition-all duration-500`} style={`width: ${bar.width};`}></div>
              </div>
              <span class="text-label-sm font-label-sm text-on-surface-variant">{bar.note}</span>
            </div>
          ))}
        </div>

        <div class="pt-space-sm flex items-center justify-between text-label-sm font-label-sm text-on-surface-variant">
          <span>{methodology}</span>
          <a class="text-primary font-semibold hover:underline" href={matrixLinkHref} data-path={matrixLinkDataPath}>
            {matrixLinkLabel}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 bg-surface-container-lowest rounded-xl p-space-xl shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between pb-space-sm">
          <div class="flex items-center gap-space-2xs">
            <span class="w-2.5 h-2.5 rounded-full bg-error animate-ping"></span>
            <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">{alertsTitle}</h3>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant">{alertsRadarLabel}</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-md">{alertsDescription}</p>

        <div class="flex flex-col gap-space-sm">
          {alerts.map((alert) => <AlertItem alert={alert} />)}
        </div>

        <div class="pt-space-md mt-space-sm">
          <a class="w-full inline-flex items-center justify-center gap-space-2xs py-space-xs rounded-lg bg-surface-container text-primary font-label-lg text-label-lg hover:bg-primary hover:text-on-primary transition-all" href="#mapa-interactivo" data-path="mapa-interactivo">
            <Icon name="emergency_share" size={18} />
            <span>{alertsCtaLabel}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
