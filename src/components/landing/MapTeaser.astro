---
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import type { CtaLink } from "../../types/landing";

interface Props {
  badge: string;
  badgeIcon: string;
  title: string;
  paragraph: string;
  primaryCta: CtaLink;
  secondaryCta: CtaLink;
  formats: string;
  imageUrl: string;
  imageAlt: string;
}

const { badge, badgeIcon, title, paragraph, primaryCta, secondaryCta, formats, imageUrl, imageAlt } = Astro.props;
---

<section class="w-full py-space-3xl px-gutter-desktop bg-surface-container-lowest">
  <div class="max-w-7xl mx-auto">
    <div class="relative rounded-2xl overflow-hidden shadow-xl bg-on-surface text-surface">
      <div class="absolute inset-0 opacity-40">
        <img class="w-full h-full object-cover" alt={imageAlt} src={imageUrl} />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-on-surface via-on-surface/90 to-transparent"></div>

      <div class="relative z-10 p-space-xl lg:p-space-3xl max-w-2xl flex flex-col gap-space-md">
        <div class="inline-flex items-center gap-space-2xs px-space-sm py-1 rounded-full bg-primary/30 text-on-primary-container font-label-sm text-label-sm w-fit backdrop-blur-md">
          <Icon name={badgeIcon} size={16} />
          <span>{badge}</span>
        </div>

        <h2 class="font-headline-xl text-headline-xl font-bold tracking-tight text-surface">{title}</h2>
        <p class="font-body-lg text-body-lg text-inverse-on-surface/80">{paragraph}</p>

        <div class="flex flex-wrap items-center gap-space-sm pt-space-sm">
          <Button label={primaryCta.label} href={primaryCta.href} icon="map" variant="bright" dataPath={primaryCta.dataPath} />
          <Button label={secondaryCta.label} href={secondaryCta.href} icon="download" variant="outline-on-dark" dataPath={secondaryCta.dataPath} />
        </div>

        <div class="flex items-center gap-space-lg pt-space-xs font-label-sm text-label-sm text-inverse-on-surface/60">
          <span>{formats}</span>
        </div>
      </div>
    </div>
  </div>
</section>
