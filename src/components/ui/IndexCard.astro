---
import Icon from "./Icon.astro";
import type { IndexCard } from "../../types/landing";

interface Props {
  index: IndexCard;
}

const { index } = Astro.props;
---

<div class="bg-surface-container-lowest rounded-xl p-space-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
  <div class="flex flex-col gap-space-md">
    <div class={`w-12 h-12 rounded-xl ${index.iconBg} flex items-center justify-center ${index.iconFg} shadow-sm`}>
      <Icon name={index.icon} size={26} />
    </div>
    <div>
      <div class="flex items-center justify-between">
        <span class={`font-label-sm text-label-sm font-bold tracking-wider ${index.categoryTone}`}>
          {index.category}
        </span>
        <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container-low px-2 py-0.5 rounded">
          {index.bandCombo}
        </span>
      </div>
      <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface mt-1">{index.title}</h3>
    </div>
    <p class="font-body-sm text-body-sm text-on-surface-variant">{index.description}</p>
    <div class="p-space-sm rounded-lg bg-surface-container-low font-label-sm text-label-sm text-on-surface flex items-center justify-between">
      <span>Fórmula estándar:</span>
      <code class="font-bold text-primary">{index.formula}</code>
    </div>
  </div>
  <div class="mt-space-lg pt-space-md flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm">
    <span>{index.range}</span>
    <span class="text-primary font-semibold flex items-center gap-1">
      <Icon name="check_circle" size={16} />
      {index.resolution}
    </span>
  </div>
</div>
